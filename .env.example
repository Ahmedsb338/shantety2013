# ============================================================================
# SHANTETY E-COMMERCE PLATFORM (شنطتي) — ENVIRONMENT VARIABLES SPECIFICATION
# Target Domain: https://shantety.shop
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CLIENT-SIDE / BROWSER ACCESSIBLE VARIABLES (Prefix: VITE_)
# Safe for public exposure in frontend bundle
# ----------------------------------------------------------------------------

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (Public JWT with RLS enforcement)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Target Store Domain
VITE_SITE_URL=https://shantety.shop

# ----------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY SECRETS (NEVER EXPOSE IN FRONTEND OR GIT)
# Configure in Cloudflare Workers Secrets / Node.js Server Environment
# ----------------------------------------------------------------------------

# Supabase Service Role Secret Key (Privileged server-side administrative access)
# DO NOT PREFIX WITH VITE_! NEVER EXPOSE TO BROWSER CLIENTS!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Direct PostgreSQL Database Connection String (Transaction Pooler: 6543 / Session Pooler: 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Google Gemini AI API Key (Used for server-side executive business intelligence)
GEMINI_API_KEY=your-gemini-api-key

# Application Port (Node.js runtime, default: 3000)
PORT=3000
NODE_ENV=production
