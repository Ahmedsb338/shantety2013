{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shantety-shop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "REVIEWS",
      "id": "<KV_NAMESPACE_ID>"
    }
  ],
  "hyperdrive": {
    "bindings": [
      {
        "name": "HYPERDRIVE",
        "id": "<HYPERDRIVE_ID>"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
